@model DocumentFieldDialogViewModel
<dialog class="sheet-dialog" id="@Model.DialogId" aria-labelledby="@($"{Model.DialogId}-title")">
    <form method="dialog" class="dialog-close"><button aria-label="Close">×</button></form>
    <form asp-controller="DocumentTypes" asp-action="SaveField" asp-route-id="@Model.DocumentTypeId" method="post" class="dialog-form">
        <input type="hidden" name="Id" value="@Model.Field.Id" />
        <div><p class="eyebrow">Form configuration</p><h2 id="@($"{Model.DialogId}-title")">@Model.Title</h2><p>Changes apply to future submissions. Historical request values remain snapshots.</p></div>
        <div class="form-grid">
            <div class="field"><label>Label</label><input name="Label" value="@Model.Field.Label" required /></div>
            <div class="field"><label>Key</label><input name="Key" value="@Model.Field.Key" required readonly="@Model.Field.IsUsed" /></div>
            <div class="field">
                <label>Type</label>
                <select name="FieldType" disabled="@Model.Field.IsUsed">
                    @foreach (var value in Enum.GetValues<DocumentFieldType>()){<option value="@value" selected="@(value == Model.Field.FieldType)">@value</option>}
                </select>
                @if (Model.Field.IsUsed){<input type="hidden" name="FieldType" value="@Model.Field.FieldType" />}
            </div>
            <div class="field"><label>Choices</label><input name="OptionsCsv" value="@Model.Field.OptionsCsv" placeholder="Option one, Option two" /></div>
            <div class="field full"><label>Help text</label><textarea name="HelpText" rows="3">@Model.Field.HelpText</textarea></div>
            <label class="check"><input type="checkbox" name="IsRequired" value="true" checked="@Model.Field.IsRequired" /> Required</label>
        </div>
        <div class="dialog-actions"><button class="button" type="button" data-dialog-close>Cancel</button><button class="button primary" type="submit">Save field</button></div>
    </form>
</dialog>
