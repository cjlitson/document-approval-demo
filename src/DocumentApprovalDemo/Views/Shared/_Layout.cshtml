@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject DocumentApprovalDemo.Data.AppDbContext LayoutDb
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentPath = Context.Request.Path;
    var displayName = User.Identity?.Name ?? "Current user";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? "";
    var initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(x => char.ToUpperInvariant(x[0])));
    var unreadAlerts = 0;
    var pendingApprovals = 0;

    if (isAuthenticated && Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var layoutUserId))
    {
        unreadAlerts = await LayoutDb.NotificationOutbox.AsNoTracking()
            .CountAsync(x => x.UserId == layoutUserId && !x.IsRead && x.Status != NotificationStatus.Cancelled);
        pendingApprovals = await LayoutDb.ApprovalInstances.AsNoTracking()
            .CountAsync(x => x.ApproverId == layoutUserId && x.Status == ApprovalStatus.Pending);
    }

    bool IsActive(string prefix, bool exact = false) => exact
        ? string.Equals(currentPath.Value, prefix, StringComparison.OrdinalIgnoreCase)
        : currentPath.StartsWithSegments(prefix);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f172a" />
    <title>@ViewData["Title"] · Document Routing</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workflow-designer.css" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "app-body" : "public-body")">
@if (isAuthenticated)
{
    <div class="app-shell">
        <aside class="app-sidebar" id="app-sidebar" aria-label="Application navigation" tabindex="-1">
            <div class="sidebar-brand-row">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index" aria-label="Document Routing home">
                    <span class="brand-symbol" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /><path d="M10 6.5h3a4 4 0 0 1 4 4V14M7 10v7h7" /></svg>
                    </span>
                    <span class="brand-copy"><strong>Document</strong><span>Routing</span></span>
                </a>
                <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" title="Collapse navigation">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5" /></svg>
                    <span class="visually-hidden">Collapse navigation</span>
                </button>
            </div>

            <nav class="sidebar-nav" aria-label="Primary navigation">
                <a class="nav-link @(IsActive("/", exact: true) ? "is-active" : "")" asp-controller="Home" asp-action="Index" aria-current="@(IsActive("/", exact: true) ? "page" : null)" title="Dashboard">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    <span class="nav-label">Dashboard</span>
                </a>

                <div class="nav-group">
                    <span class="nav-group-label">Work</span>
                    <a class="nav-link @(IsActive("/approvals") ? "is-active" : "")" asp-controller="Approvals" asp-action="Inbox" aria-current="@(IsActive("/approvals") ? "page" : null)" title="My approvals">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                        <span class="nav-label">My approvals</span>
                        @if (pendingApprovals > 0)
                        {
                            <span class="nav-badge">@pendingApprovals</span>
                        }
                    </a>
                    <a class="nav-link @(IsActive("/requests") ? "is-active" : "")" asp-controller="Requests" asp-action="Index" aria-current="@(IsActive("/requests") ? "page" : null)" title="My requests">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" /></svg>
                        <span class="nav-label">My requests</span>
                    </a>
                    @if (User.IsInRole(Roles.SystemAdmin))
                    {
                        <a class="nav-link @(IsActive("/admin/requests") ? "is-active" : "")" asp-controller="Administration" asp-action="Requests" aria-current="@(IsActive("/admin/requests") ? "page" : null)" title="All requests">
                            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 4h3a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2v-2" /><path d="M3 4h11v12H3zM6 8h5M6 12h4" /></svg>
                            <span class="nav-label">All requests</span>
                        </a>
                    }
                    <a class="nav-link @(IsActive("/notifications") ? "is-active" : "")" asp-controller="Notifications" asp-action="Index" aria-current="@(IsActive("/notifications") ? "page" : null)" title="Alerts">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                        <span class="nav-label">Alerts</span>
                        @if (unreadAlerts > 0)
                        {
                            <span class="nav-badge subtle">@unreadAlerts</span>
                        }
                    </a>
                </div>

                @if (User.IsInRole(Roles.SystemAdmin))
                {
                    <div class="nav-group">
                        <span class="nav-group-label">Configuration</span>
                        <a class="nav-link @(IsActive("/route-designer") ? "is-active" : "")" href="/route-designer" aria-current="@(IsActive("/route-designer") ? "page" : null)" title="Workflows">
                            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="2" /><circle cx="18" cy="18" r="2" /><path d="M8 6h3a4 4 0 0 1 4 4v4M6 8v6a4 4 0 0 0 4 4h6" /></svg>
                            <span class="nav-label">Workflows</span>
                        </a>
                        <a class="nav-link @(IsActive("/admin/document-types") ? "is-active" : "")" asp-controller="Administration" asp-action="DocumentTypes" aria-current="@(IsActive("/admin/document-types") ? "page" : null)" title="Document types">
                            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" /></svg>
                            <span class="nav-label">Document types</span>
                        </a>
                    </div>
                    <div class="nav-group">
                        <span class="nav-group-label">Administration</span>
                        <a class="nav-link @(IsActive("/admin/routes") ? "is-active" : "")" asp-controller="AdminRoutes" asp-action="Index" aria-current="@(IsActive("/admin/routes") ? "page" : null)" title="Administration">
                            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" /><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V21h-4v-.09A1.7 1.7 0 0 0 9 19.36a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.63 15 1.7 1.7 0 0 0 3.08 14H3v-4h.09A1.7 1.7 0 0 0 4.64 9a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.63 1.7 1.7 0 0 0 10 3.08V3h4v.09A1.7 1.7 0 0 0 15 4.64a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.37 9 1.7 1.7 0 0 0 20.92 10H21v4h-.09A1.7 1.7 0 0 0 19.4 15z" /></svg>
                            <span class="nav-label">Administration</span>
                        </a>
                    </div>
                }
            </nav>

            <div class="sidebar-footer">
                <a class="nav-link utility-link @(IsActive("/help", exact: true) ? "is-active" : "")" asp-controller="Home" asp-action="Help" title="Help">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 1 1 3.3 2.37c-.8.3-.8.88-.8 1.63M12 17h.01" /></svg>
                    <span class="nav-label">Help</span>
                </a>
                <details class="account-menu">
                    <summary>
                        <span class="user-avatar">@(string.IsNullOrWhiteSpace(initials) ? "U" : initials)</span>
                        <span class="account-copy"><strong>@displayName</strong><small>@email</small></span>
                        <svg class="account-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg>
                    </summary>
                    <div class="account-popover">
                        <strong>@displayName</strong><small>@email</small>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Switch demo user</button></form>
                    </div>
                </details>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="mobile-menu-button" type="button" data-sidebar-open aria-controls="app-sidebar" aria-expanded="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    <span class="visually-hidden">Open navigation</span>
                </button>
                <div class="topbar-context"><span>Workspace</span><strong>@ViewData["Title"]</strong></div>
                <div class="topbar-actions">
                    <a class="notification-button" asp-controller="Notifications" asp-action="Index" aria-label="Notifications, @unreadAlerts unread">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                        @if (unreadAlerts > 0)
                        {
                            <span>@(unreadAlerts > 99 ? "99+" : unreadAlerts.ToString())</span>
                        }
                    </a>
                </div>
            </header>

            <main class="page-shell">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert success" role="status">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert error" role="alert">@error</div>
                }
                @RenderBody()
            </main>
            <footer class="app-footer">Demonstration environment · simulated Email/Teams delivery · not for production signatures</footer>
        </div>
        <button class="sidebar-backdrop" type="button" data-sidebar-close aria-label="Close navigation"></button>
    </div>
}
else
{
    <header class="public-header">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /><path d="M10 6.5h3a4 4 0 0 1 4 4V14M7 10v7h7" /></svg></span>
            <span class="brand-copy"><strong>Document</strong><span>Routing</span></span>
        </a>
    </header>
    <main class="public-page-shell">@RenderBody()</main>
    <footer class="public-footer">Document Routing demonstration environment</footer>
}

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
