@model StatusBadgeViewModel

<span class="status-badge @Model.Tone">
    <span class="status-badge-icon" aria-hidden="true">
        @if (Model.Tone == "success")
        {
            <svg viewBox="0 0 16 16"><path d="m3.5 8 3 3 6-6" /></svg>
        }
        else if (Model.Tone == "danger")
        {
            <svg viewBox="0 0 16 16"><path d="m5 5 6 6M11 5l-6 6" /></svg>
        }
        else if (Model.Tone == "warning")
        {
            <svg viewBox="0 0 16 16"><path d="M8 4v4.25M8 11.5h.01" /></svg>
        }
        else if (Model.Tone == "info")
        {
            <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="4.5" /><path d="M8 5.5V8l1.75 1" /></svg>
        }
        else
        {
            <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="3.25" /></svg>
        }
    </span>
    @Model.Label
</span>
