@model RoutingHistoryViewModel

<section class="panel routing-history" aria-labelledby="routing-history-title">
    <div class="panel-heading">
        <div>
            <h2 id="routing-history-title">Routing history</h2>
            <p>Revision @Model.RevisionNumber · route version @(Model.RouteVersionNumber?.ToString() ?? "—")</p>
        </div>
    </div>
    <ol class="routing-timeline">
        @foreach (var item in Model.Items)
        {
            <li class="routing-event @item.State">
                <span class="routing-marker" aria-hidden="true">
                    @if (item.State == "completed")
                    {
                        <svg viewBox="0 0 20 20"><path d="m5 10 3 3 7-7" /></svg>
                    }
                    else if (item.State == "current")
                    {
                        <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6" /><path d="M10 6v4l2.5 1.5" /></svg>
                    }
                    else if (item.State == "error")
                    {
                        <svg viewBox="0 0 20 20"><path d="m7 7 6 6M13 7l-6 6" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="4" /></svg>
                    }
                </span>
                <div class="routing-event-body">
                    <div class="routing-event-heading">
                        <strong>@item.Title</strong>
                        <span class="history-status">@item.StatusLabel</span>
                    </div>
                    @if (item.TimestampUtc.HasValue)
                    {
                        <time datetime="@item.TimestampUtc.Value.ToString("O")">@item.TimestampUtc.Value.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</time>
                    }
                    else
                    {
                        <span class="future-time">Not started</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.ActorName))
                    {
                        <p class="routing-actor">@item.ActorName</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Detail))
                    {
                        <p class="routing-detail">@item.Detail</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Signature))
                    {
                        <div class="history-evidence"><span>Signature captured</span><strong>@item.Signature</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Transition))
                    {
                        <p class="history-transition">@item.Transition</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Comments))
                    {
                        <blockquote><span>Comment</span>@item.Comments</blockquote>
                    }
                </div>
            </li>
        }
    </ol>
</section>
