@model IReadOnlyList<ApprovalInstance>
@{ ViewData["Title"] = "Approval inbox"; }
<div class="page-heading"><div><p class="eyebrow">Approver workspace</p><h1>Waiting on me</h1><p>Only the currently active stage appears in this queue.</p></div></div>
<section class="panel">
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">✓</div><h2>All caught up</h2><p>You have no pending approvals for this identity.</p></div>
}
else
{
    <table><thead><tr><th>Request</th><th>Requester</th><th>Stage</th><th>Amount</th><th>Waiting since</th><th></th></tr></thead><tbody>
    @foreach (var approval in Model)
    {
        <tr><td><strong>@approval.Request.RequestNumber</strong><small>@approval.Request.Title</small></td><td>@approval.Request.Requester.FullName</td><td>@approval.StageName</td><td>@approval.Request.Amount.ToString("C")</td><td>@approval.ActivatedAtUtc?.ToLocalTime().ToString("g")</td><td><a class="button small" asp-action="Review" asp-route-id="@approval.Id">Review</a></td></tr>
    }
    </tbody></table>
}
</section>

