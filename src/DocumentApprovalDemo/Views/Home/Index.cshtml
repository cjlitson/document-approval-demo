@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var metrics = new[]
    {
        new MetricCardViewModel(
            "My approvals",
            Model.MyPendingApprovals,
            "Requests waiting for your decision",
            "Open approval queue",
            Url.Action("Inbox", "Approvals") ?? "/approvals",
            "approval",
            Model.MyPendingApprovals > 0 ? "info" : "neutral"),
        new MetricCardViewModel(
            "Active requests",
            Model.ActiveRequests,
            "Your requests moving through a workflow",
            "View my requests",
            Url.Action("Index", "Requests") ?? "/requests",
            "active"),
        new MetricCardViewModel(
            "Needs attention",
            Model.NeedsAttention,
            "Rejected requests ready for revision",
            "Review requests",
            Url.Action("Index", "Requests") ?? "/requests",
            "attention",
            Model.NeedsAttention > 0 ? "danger" : "neutral"),
        new MetricCardViewModel(
            "Completed",
            Model.CompletedLast30Days,
            "Approved requests in the last 30 days",
            "View completed requests",
            Url.Action("Index", "Requests") ?? "/requests",
            "completed",
            "success")
    };
}

<div class="page-heading dashboard-heading">
    <div>
        <p class="eyebrow">Document routing</p>
        <h1>Dashboard</h1>
        <p>Here's what needs your attention.</p>
    </div>
    <a class="button primary" asp-controller="Requests" asp-action="Create">
        <svg class="button-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
        New request
    </a>
</div>

<section class="metric-grid" aria-label="Workflow summary">
    @foreach (var metric in metrics)
    {
        <partial name="_MetricCard" model="@metric" />
    }
</section>

<partial name="_ApprovalQueue" model="@Model.ApprovalQueue" />

@if (Model.ManagedDocumentTypes.Count > 0)
{
    <section class="managed-types" aria-labelledby="managed-types-title">
        <div class="section-heading"><div><p class="eyebrow">Operational oversight</p><h2 id="managed-types-title">Document Types I Manage</h2></div><a asp-controller="ManagedRequests" asp-action="Index">View managed requests</a></div>
        <div class="managed-type-grid">
        @foreach (var item in Model.ManagedDocumentTypes)
        {
            <a class="managed-type-card" asp-controller="ManagedRequests" asp-action="Index" asp-route-documentTypeId="@item.DocumentTypeId">
                <strong>@item.Name</strong>
                <dl><div><dt>Active</dt><dd>@item.Active</dd></div><div><dt>Needs attention</dt><dd>@item.NeedsAttention</dd></div><div><dt>Completed recently</dt><dd>@item.CompletedRecently</dd></div></dl>
            </a>
        }
        </div>
    </section>
}

<div class="dashboard-secondary-grid">
    <section class="panel recent-requests" aria-labelledby="recent-requests-title">
        <div class="panel-heading">
            <div>
                <h2 id="recent-requests-title">Recent requests</h2>
                <p>Your latest submissions and their current workflow stage.</p>
            </div>
            <a asp-controller="Requests" asp-action="Index">View all</a>
        </div>
        @if (Model.RecentRequests.Count == 0)
        {
            <div class="empty-state compact">
                <p>No requests yet. Start one when you're ready.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table compact-table">
                    <thead>
                    <tr><th>Request</th><th>Current stage</th><th>Status</th><th>Created</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var request in Model.RecentRequests)
                    {
                        <tr class="clickable-row" data-href="/requests/@request.Id" tabindex="0">
                            <td>
                                <a class="request-link" asp-controller="Requests" asp-action="Details" asp-route-id="@request.Id">@request.Title</a>
                                <small>@request.RequestNumber · @request.DocumentTypeName</small>
                            </td>
                            <td>@request.CurrentStage</td>
                            <td><partial name="_StatusBadge" model="@StatusBadgeViewModel.For(request.Status)" /></td>
                            <td>@request.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <partial name="_ActivityList" model="@Model.RecentActivity" />
</div>
