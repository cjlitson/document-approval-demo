@model IReadOnlyList<ApprovalRequest>
@{ ViewData["Title"] = "My requests"; }
<div class="page-heading"><div><p class="eyebrow">Requester workspace</p><h1>My requests</h1><p>Document approvals across every configured request type.</p></div><a class="button primary" asp-action="Create"><svg class="button-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>New request</a></div>
<section class="panel">
@if (Model.Count == 0)
{
    <div class="empty-state"><h2>No requests yet</h2><p>Choose a document type and attach the required supporting material.</p></div>
}
else
{
    <table><thead><tr><th>Request</th><th>Title</th><th>Document type</th><th>Revision</th><th>Status</th></tr></thead><tbody>
    @foreach (var request in Model)
    {
        <tr class="clickable-row" data-href="/requests/@request.Id" tabindex="0"><td><a asp-action="Details" asp-route-id="@request.Id">@request.RequestNumber</a></td><td>@request.Title<small>@request.Department</small></td><td>@request.DocumentType.Name</td><td>@request.CurrentRevisionNumber</td><td><partial name="_StatusBadge" model="@StatusBadgeViewModel.For(request.Status)" /></td></tr>
    }
    </tbody></table>
}
</section>
