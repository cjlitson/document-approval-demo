@model RouteDraftViewModel
@{ ViewData["Title"] = "Configure route draft"; }
<div class="page-heading"><div><p class="eyebrow">Unpublished route version</p><h1>Configure draft</h1><p>Exactly $1,000 follows the operator selected below; no amount behavior is hardcoded.</p></div></div>
<form method="post" class="panel form-panel narrow">
    <input asp-for="VersionId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field"><label asp-for="Name">Version label</label><input asp-for="Name" /></div>
    <fieldset><legend>Stage 1 · Manager</legend><p class="help">Assigned from the requester’s confirmed Entra manager selection.</p></fieldset>
    <fieldset><legend>Stage 2 · Conditional President</legend>
        <div class="field"><label asp-for="PresidentApproverId">Named approver</label><select asp-for="PresidentApproverId" asp-items="Model.Approvers"></select></div>
        <div class="form-row"><div class="field"><label asp-for="PresidentAmountOperator">Amount operator</label><select asp-for="PresidentAmountOperator" asp-items="Html.GetEnumSelectList<ComparisonOperator>()"></select></div><div class="field"><label asp-for="PresidentAmountThreshold">Threshold</label><input asp-for="PresidentAmountThreshold" type="number" step="0.01" /></div></div>
    </fieldset>
    <fieldset><legend>Stage 3 · VP Finance (final)</legend><div class="field"><label asp-for="FinanceApproverId">Named approver</label><select asp-for="FinanceApproverId" asp-items="Model.Approvers"></select></div></fieldset>
    <div class="form-actions"><a class="button" asp-action="Index">Back</a><button class="button" type="submit">Save draft</button></div>
</form>
<form asp-action="Publish" asp-route-id="@Model.VersionId" method="post" class="publish-bar"><div><strong>Ready to make this route active?</strong><p>Publishing retires the current version for new requests. Existing requests remain unchanged.</p></div><button class="button primary" type="submit">Publish route version</button></form>

