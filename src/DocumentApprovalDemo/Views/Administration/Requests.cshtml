@model IReadOnlyList<ApprovalRequest>
@{
    ViewData["Title"] = "All requests";
}

<div class="page-heading">
    <div><p class="eyebrow">Administration</p><h1>All requests</h1><p>Read-only oversight across every configured document type.</p></div>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>No requests yet</h2><p>Submitted requests will appear here for central administrators.</p></div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th>Request</th><th>Document type</th><th>Requester</th><th>Department</th><th>Revision</th><th>Status</th><th>Created</th></tr></thead>
                <tbody>
                @foreach (var request in Model)
                {
                    <tr class="clickable-row" data-href="/requests/@request.Id" tabindex="0">
                        <td><a class="request-link" asp-controller="Requests" asp-action="Details" asp-route-id="@request.Id">@request.Title</a><small>@request.RequestNumber</small></td>
                        <td>@request.DocumentType.Name</td>
                        <td>@request.Requester.FullName</td>
                        <td>@request.Department</td>
                        <td>@request.CurrentRevisionNumber</td>
                        <td><partial name="_StatusBadge" model="@StatusBadgeViewModel.For(request.Status)" /></td>
                        <td>@request.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
