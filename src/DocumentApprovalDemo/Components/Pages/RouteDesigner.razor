@page "/route-designer"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.SystemAdmin)]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IRouteValidationService RouteValidator
@inject IRouteVersionCloningService RouteCloner
@inject IRouteVersionDiffService RouteDiff
@inject IRouteSimulationService RouteSimulator

<PageTitle>Route designer · Document Routing</PageTitle>

<nav class="designer-breadcrumb" aria-label="Breadcrumb">
    <a href="/admin/document-types">Document types</a><span aria-hidden="true">/</span><span>Route designer</span>
</nav>

<header class="page-heading designer-heading">
    <div>
        <p class="eyebrow">Sequential workflow configuration</p>
        <h1>Route Designer</h1>
        <p>Build an explainable approval sequence with typed conditions. Execution remains sequential.</p>
    </div>
    @if (Route is not null)
    {
        <div class="designer-heading-actions">
            <span class="status large @Route.Status.ToString().ToLowerInvariant()">@Route.Status · v@Route.VersionNumber</span>
            @if (IsDraft)
            {
                <button type="button" class="button" @onclick="SaveDraftAsync">Save draft</button>
                <button type="button" class="button primary" @onclick="BeginPublishAsync">Publish</button>
            }
            else
            {
                <button type="button" class="button primary" @onclick="CreateDraftAsync">Create editable draft</button>
            }
        </div>
    }
</header>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert @(IsError ? "error" : "success")" role="status">@Message</div>
}

<section class="designer-toolbar panel">
    <div class="field">
        <label for="document-type-selector">Document type</label>
        <select id="document-type-selector" value="@SelectedDocumentTypeId" @onchange="ChangeDocumentTypeAsync">
            @foreach (var type in DocumentTypes)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </select>
    </div>
    @if (Route is not null)
    {
        <div class="field route-version-name">
            <label for="route-version-name">Version label</label>
            <input id="route-version-name" @bind="Route.Name" @bind:event="oninput" disabled="@(!IsDraft)" />
        </div>
    }
    <a class="button" href="/admin/routes">Version history</a>
</section>

@if (Route is null)
{
    <section class="panel empty-state"><h2>No route configured</h2><p>This document type has no published route.</p></section>
}
else
{
    var readiness = Readiness;
    <div class="designer-workspace">
        <main class="route-workspace">
            <section class="panel route-canvas" aria-label="Visual sequential route">
                <div class="panel-heading">
                    <div><h2>Visual route</h2><p>Stages run from top to bottom. Conditional stages may be skipped.</p></div>
                    <span>@Route.Stages.Count stage@(Route.Stages.Count == 1 ? "" : "s")</span>
                </div>
                <div class="route-sequence">
                    @foreach (var stage in Route.Stages.OrderBy(x => x.Sequence).ToList())
                    {
                        var counts = ConditionFormatter.Count(stage);
                        var problemCount = readiness.Errors.Count(x => x.StageKey == stage.StageKey);
                        <div class="route-sequence-item" draggable="@(IsDraft ? "true" : "false")"
                             @ondragstart="() => BeginDrag(stage.StageKey)" @ondragover:preventDefault
                             @ondrop="() => DropBefore(stage.StageKey)" @key="stage.StageKey">
                            <button type="button" class="route-node @(stage.IsConditional ? "conditional" : "always") @(SelectedStageKey == stage.StageKey ? "is-selected" : null) @(problemCount > 0 ? "has-error" : null)"
                                    @onclick="() => SelectStageAsync(stage.StageKey)" aria-pressed="@(SelectedStageKey == stage.StageKey)">
                                <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                                <span class="node-number">@stage.Sequence</span>
                                <span class="node-copy">
                                    <strong>@stage.Name</strong>
                                    <small>@AssignmentLabel(stage)</small>
                                    <small>@(stage.IsConditional ? $"Conditional · {counts.Groups} group{(counts.Groups == 1 ? "" : "s")} · {counts.Rules} rule{(counts.Rules == 1 ? "" : "s")}" : "Always runs")</small>
                                    <small>@AlertSummary(stage)</small>
                                </span>
                                @if (problemCount > 0)
                                {
                                    <span class="node-problem" title="@($"{problemCount} validation problem(s)")">! @problemCount</span>
                                }
                            </button>
                            @if (IsDraft)
                            {
                                <div class="node-keyboard-actions" aria-label="Reorder stage">
                                    <button type="button" class="icon-button" aria-label="Move @stage.Name up" disabled="@(stage.Sequence == 1)" @onclick="() => MoveStage(stage.StageKey, -1)">↑</button>
                                    <button type="button" class="icon-button" aria-label="Move @stage.Name down" disabled="@(stage.Sequence == Route.Stages.Count)" @onclick="() => MoveStage(stage.StageKey, 1)">↓</button>
                                </div>
                                <button type="button" class="add-between" aria-label="Add stage after @stage.Name" @onclick="() => InsertStage(stage.StageKey)"><span>+</span> Add stage</button>
                            }
                            else if (stage.Sequence < Route.Stages.Count)
                            {
                                <span class="route-connector" aria-hidden="true">↓</span>
                            }
                        </div>
                    }
                    @if (IsDraft && Route.Stages.Count == 0)
                    {
                        <button type="button" class="button add-stage" @onclick="() => InsertStage(null)">+ Add first approval stage</button>
                    }
                </div>
            </section>

            <section class="panel readiness-panel" aria-labelledby="readiness-title">
                <div class="panel-heading">
                    <div><h2 id="readiness-title">Publish readiness</h2><p>Server-side checks run again inside the publication transaction.</p></div>
                    <span class="readiness-state @(readiness.IsReady ? "ready" : "blocked")">@(readiness.IsReady ? "Ready to publish" : $"{readiness.Errors.Count} issue{(readiness.Errors.Count == 1 ? "" : "s")} to fix")</span>
                </div>
                <ul class="readiness-list">
                    @if (readiness.Errors.Count == 0)
                    {
                        <li class="is-ready"><span>✓</span><div><strong>@Route.Stages.Count stages configured</strong><small>Assignments, conditions, alerts, and lifecycle references are valid.</small></div></li>
                    }
                    @foreach (var issue in readiness.Issues.Where(x => x.Severity != RouteValidationSeverity.Information))
                    {
                        <li class="@issue.Severity.ToString().ToLowerInvariant()">
                            <span>@(issue.Severity == RouteValidationSeverity.Error ? "!" : "i")</span>
                            <button type="button" @onclick="() => FocusIssueAsync(issue)">@issue.Message</button>
                        </li>
                    }
                </ul>
            </section>

            <section class="panel simulator" aria-labelledby="simulator-title">
                <div class="panel-heading"><div><h2 id="simulator-title">Explainable route simulator</h2><p>Uses the same condition evaluator as live routing.</p></div></div>
                <div class="simulator-layout">
                    <div class="simulator-fields">
                        <div class="field"><label for="simulation-title">Request title</label><input id="simulation-title" @bind="SimulationTitle" @bind:event="oninput" /></div>
                        <div class="field"><label for="simulation-department">Department</label><input id="simulation-department" @bind="SimulationDepartment" @bind:event="oninput" /></div>
                        <div class="field">
                            <label for="simulation-manager">Requester manager</label>
                            <select id="simulation-manager" @bind="SimulationManagerId">
                                <option value="">Not selected</option>
                                @foreach (var user in Users.Where(x => x.IsActive).OrderBy(x => x.FullName))
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                        </div>
                        @foreach (var field in CurrentFields)
                        {
                            <div class="field">
                                <label for="simulation-@field.Key">@field.Label</label>
                                @if (field.FieldType == DocumentFieldType.Choice)
                                {
                                    <select id="simulation-@field.Key" value="@SimulationValue(field.Key)" @onchange="args => SetSimulation(field.Key, args.Value?.ToString())">
                                        <option value="">Select value</option>
                                        @foreach (var option in field.Options)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                }
                                else if (field.FieldType == DocumentFieldType.Boolean)
                                {
                                    <select id="simulation-@field.Key" value="@SimulationValue(field.Key)" @onchange="args => SetSimulation(field.Key, args.Value?.ToString())">
                                        <option value="">Not selected</option><option value="true">Yes</option><option value="false">No</option>
                                    </select>
                                }
                                else if (field.FieldType == DocumentFieldType.User)
                                {
                                    <select id="simulation-@field.Key" data-combobox value="@SimulationValue(field.Key)" @onchange="args => SetSimulation(field.Key, args.Value?.ToString())">
                                        <option value="">Select person</option>
                                        @foreach (var user in Users.Where(x => x.IsActive).OrderBy(x => x.FullName))
                                        {
                                            <option value="@user.Id">@user.FullName — @user.Email</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input id="simulation-@field.Key" type="@(field.FieldType == DocumentFieldType.Currency ? "number" : field.FieldType == DocumentFieldType.Date ? "date" : "text")"
                                           value="@SimulationValue(field.Key)" @oninput="args => SetSimulation(field.Key, args.Value?.ToString())" />
                                }
                            </div>
                        }
                    </div>
                    <ol class="simulation-results">
                        @foreach (var result in SimulationResults)
                        {
                            <li class="simulation-stage @(result.Included ? "included" : "skipped")">
                                <header><span>@(result.Included ? "✓" : "×")</span><div><strong>@result.Sequence. @result.StageName</strong><small>@(result.Included ? "Included" : "Skipped") · @result.AssignmentStrategy</small></div></header>
                                <p class="assignee @(result.AssigneeResolved ? "" : "unresolved")">Assignee: @result.Assignee</p>
                                @if (result.Evaluation.GroupResult is not null)
                                {
                                    <ul class="evaluation-tree" aria-label="Condition evaluation for @result.StageName">
                                        <ConditionEvaluationView Node="result.Evaluation.GroupResult" />
                                    </ul>
                                }
                                else
                                {
                                    <p class="always-explanation">@result.Evaluation.Explanation</p>
                                }
                            </li>
                        }
                    </ol>
                </div>
            </section>
        </main>

        @if (SelectedStage is not null)
        {
            var stage = SelectedStage;
            <aside class="stage-sheet panel" tabindex="-1" @ref="StagePanel" aria-label="Edit @stage.Name" @onkeydown="StagePanelKeyDown">
                <header class="stage-sheet-heading">
                    <div><p class="eyebrow">Stage @stage.Sequence</p><h2>@stage.Name</h2></div>
                    <div class="stage-sheet-heading-actions"><span class="status @(stage.IsConditional ? "draft" : "published")">@(stage.IsConditional ? "Conditional" : "Always")</span><button type="button" class="icon-button sheet-close" aria-label="Close stage editor" @onclick="CloseStageEditor">×</button></div>
                </header>

                <section class="stage-section">
                    <h3>Stage details</h3>
                    <div class="field"><label for="selected-stage-name">Name</label><input id="selected-stage-name" @bind="stage.Name" @bind:event="oninput" disabled="@(!IsDraft)" /></div>
                </section>

                <section class="stage-section">
                    <h3>Assignment</h3>
                    <div class="field"><label for="assignment-strategy">Strategy</label><select id="assignment-strategy" @bind="stage.AssignmentStrategy" disabled="@(!IsDraft)">
                        @foreach (var strategy in Enum.GetValues<AssignmentStrategy>())
                        {
                            <option value="@strategy">@StrategyLabel(strategy)</option>
                        }
                    </select></div>
                    @if (stage.AssignmentStrategy == AssignmentStrategy.NamedUser)
                    {
                        <div class="field"><label for="named-approver">Named person</label><select id="named-approver" data-combobox @bind="stage.NamedApproverId" disabled="@(!IsDraft)">
                            <option value="">Select person</option>
                            @foreach (var user in Users.Where(x => x.IsActive).OrderBy(x => x.FullName))
                            {
                                <option value="@user.Id">@user.FullName — @user.Email</option>
                            }
                        </select></div>
                    }
                    else if (stage.AssignmentStrategy == AssignmentStrategy.UserField)
                    {
                        <div class="field"><label for="assignee-field">Person field</label><select id="assignee-field" @bind="stage.AssigneeFieldKey" disabled="@(!IsDraft)">
                            <option value="">Select User field</option>
                            @foreach (var field in CurrentFields.Where(x => x.FieldType == DocumentFieldType.User))
                            {
                                <option value="@field.Key">@field.Label</option>
                            }
                        </select></div>
                    }
                </section>

                <section class="stage-section">
                    <h3>Signature</h3>
                    <div class="locked-setting"><span>✓</span><div><strong>Adopted signature required</strong><small>The approver must type their authenticated full name.</small></div></div>
                </section>

                <section class="stage-section condition-editor-section">
                    <h3>Conditions</h3>
                    <div class="run-mode" role="group" aria-label="Stage condition mode">
                        <button type="button" class="@(stage.IsConditional ? null : "is-selected")" disabled="@(!IsDraft)" @onclick="() => SetConditional(stage, false)">Always runs</button>
                        <button type="button" class="@(stage.IsConditional ? "is-selected" : null)" disabled="@(!IsDraft)" @onclick="() => SetConditional(stage, true)">Run when conditions match</button>
                    </div>
                    @if (stage.IsConditional && RootGroup(stage) is { } root)
                    {
                        <p class="condition-summary">@ConditionFormatter.StageSummary(stage, ConditionFields)</p>
                        <ConditionGroupEditor Stage="stage" Group="root" Fields="ConditionFields" Users="Users" Disabled="@(!IsDraft)" Root="true" Changed="ConfigurationChanged" />
                    }
                </section>

                <section class="stage-section">
                    <h3>Alert policy</h3>
                    <div class="alert-policy-list">
                        @foreach (var alert in stage.AlertPolicies.OrderBy(x => x.EventType))
                        {
                            <article class="alert-policy-card">
                                <header><strong>@alert.EventType</strong><label class="switch"><input type="checkbox" @bind="alert.IsEnabled" disabled="@(!IsDraft || alert.EventType is AlertEventType.Assignment or AlertEventType.Outcome)" /> Enabled</label></header>
                                @if (alert.EventType is AlertEventType.Reminder or AlertEventType.Escalation)
                                {
                                    <div class="field compact"><label>Delay (hours)</label><input type="number" min="1" @bind="alert.DelayHours" disabled="@(!IsDraft || !alert.IsEnabled)" /></div>
                                }
                                @if (alert.EventType == AlertEventType.Escalation)
                                {
                                    <div class="field compact"><label>Recipient</label><select @bind="alert.RecipientStrategy" disabled="@(!IsDraft || !alert.IsEnabled)">
                                        @foreach (var recipient in Enum.GetValues<AlertRecipientStrategy>())
                                        {
                                            <option value="@recipient">@recipient</option>
                                        }
                                    </select></div>
                                }
                                <div class="channel-checks"><label><input type="checkbox" @bind="alert.InAppEnabled" disabled="@(!IsDraft || !alert.IsEnabled)" /> In-app</label><label><input type="checkbox" @bind="alert.EmailEnabled" disabled="@(!IsDraft || !alert.IsEnabled)" /> Email</label><label><input type="checkbox" @bind="alert.TeamsEnabled" disabled="@(!IsDraft || !alert.IsEnabled)" /> Teams</label></div>
                            </article>
                        }
                    </div>
                </section>

                @if (IsDraft)
                {
                    <section class="stage-section danger-zone"><h3>Danger zone</h3><p>Remove this stage from the draft. Published versions remain unchanged.</p><button type="button" class="button danger" @onclick="() => RemoveStage(stage.StageKey)">Remove stage</button></section>
                }
            </aside>
        }
    </div>

    @if (ShowPublishReview && PublishDiff is not null)
    {
        <section class="publish-review" role="dialog" aria-modal="true" aria-labelledby="publish-review-title" tabindex="-1" @ref="PublishPanel" @onkeydown="PublishPanelKeyDown">
            <div class="publish-review-card panel">
                <header><div><p class="eyebrow">Final review</p><h2 id="publish-review-title">Publish version @Route.VersionNumber</h2><p>Review readiness, warnings, and semantic changes before publication.</p></div><button type="button" class="icon-button" aria-label="Close publish review" @onclick="ClosePublishReview">×</button></header>
                <div class="publish-review-grid">
                    <section>
                        <h3>Readiness</h3><p class="readiness-state ready">✓ All blocking checks passed</p>
                        @foreach (var warning in readiness.Warnings)
                        {
                            <p class="publish-warning">! @warning.Message</p>
                        }
                    </section>
                    <section><h3>Changes from @(PublishDiff.PreviousVersionNumber.HasValue ? $"version {PublishDiff.PreviousVersionNumber}" : "no prior version")</h3>
                        @if (!PublishDiff.HasChanges)<p>No semantic changes detected.</p>
                        @foreach (var group in PublishDiff.Items.GroupBy(x => x.Kind))
                        {
                            <div class="diff-group">
                                <h4>@group.Key.ToString().ToUpperInvariant()</h4>
                                @foreach (var item in group)
                                {
                                    <article>
                                        <strong>@item.StageName</strong><span>@item.Description</span>
                                        @if (item.Before is not null || item.After is not null)
                                        {
                                            <small>@item.Before → @item.After</small>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </div>
                <footer><button type="button" class="button" @onclick="ClosePublishReview">Cancel</button><button type="button" class="button primary" disabled="@(!readiness.IsReady || IsPublishing)" @onclick="ConfirmPublishAsync">@(IsPublishing ? "Publishing…" : $"Confirm publish version {Route.VersionNumber}")</button></footer>
            </div>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "documentTypeId")] public Guid? RequestedDocumentTypeId { get; set; }

    private List<DocumentTypeSummary> DocumentTypes { get; set; } = [];
    private List<ApplicationUser> Users { get; set; } = [];
    private List<DocumentFieldDefinition> CurrentFields { get; set; } = [];
    private List<LifecycleNotificationRule> LifecycleRules { get; set; } = [];
    private Dictionary<string, string?> SimulationValues { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private Guid SelectedDocumentTypeId { get; set; }
    private Guid? SimulationManagerId { get; set; }
    private ApprovalRouteVersion? Route { get; set; }
    private string? SelectedStageKey { get; set; }
    private string? DraggedStageKey { get; set; }
    private string? Message { get; set; }
    private bool IsError { get; set; }
    private bool ShowPublishReview { get; set; }
    private bool IsPublishing { get; set; }
    private RouteVersionDiffResult? PublishDiff { get; set; }
    private ElementReference StagePanel { get; set; }
    private ElementReference PublishPanel { get; set; }

    private bool IsDraft => Route?.Status == RouteVersionStatus.Draft;
    private ApprovalRouteStage? SelectedStage => Route?.Stages.SingleOrDefault(x => x.StageKey == SelectedStageKey);
    private IReadOnlyList<ConditionField> ConditionFields => ConditionField.Build(CurrentFields);
    private RouteValidationResult Readiness => Route is null
        ? new RouteValidationResult([])
        : RouteValidator.Validate(Route, CurrentFields, Users, LifecycleRules);
    private IReadOnlyList<RouteSimulationStageResult> SimulationResults => Route is null ? [] :
        RouteSimulator.Simulate(Route, SimulationContext(), ConditionFields, Users);
    private string SimulationTitle { get => SimulationValue("title"); set => SetSimulation("title", value); }
    private string SimulationDepartment { get => SimulationValue("department"); set => SetSimulation("department", value); }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        DocumentTypes = await db.DocumentTypes.AsNoTracking().Where(x => x.IsActive)
            .OrderBy(x => x.Key == "purchase-request" ? 0 : 1).ThenBy(x => x.Name)
            .Select(x => new DocumentTypeSummary(x.Id, x.Name)).ToListAsync();
        Users = await db.Users.AsNoTracking().OrderBy(x => x.FullName).ToListAsync();
        SimulationManagerId = Users.FirstOrDefault(x => x.Id == DemoDataSeeder.ManagerId)?.Id ?? Users.FirstOrDefault(x => x.IsActive)?.Id;
        if (DocumentTypes.Count == 0) return;
        SelectedDocumentTypeId = RequestedDocumentTypeId.HasValue && DocumentTypes.Any(x => x.Id == RequestedDocumentTypeId.Value)
            ? RequestedDocumentTypeId.Value : DocumentTypes[0].Id;
        await LoadRouteAsync();
    }

    private async Task ChangeDocumentTypeAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id)) SelectedDocumentTypeId = id;
        Message = null;
        ShowPublishReview = false;
        await LoadRouteAsync();
    }

    private async Task LoadRouteAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        CurrentFields = await db.DocumentFields.AsNoTracking().Where(x => x.DocumentTypeId == SelectedDocumentTypeId).OrderBy(x => x.Sequence).ToListAsync();
        LifecycleRules = await db.LifecycleNotificationRules.AsNoTracking().Where(x => x.DocumentTypeId == SelectedDocumentTypeId).ToListAsync();
        ResetSimulationValues();
        var versions = await VersionGraph(db).AsNoTrackingWithIdentityResolution()
            .Where(x => x.Route.DocumentTypeId == SelectedDocumentTypeId).ToListAsync();
        Route = versions.Where(x => x.Status == RouteVersionStatus.Draft).OrderByDescending(x => x.VersionNumber).FirstOrDefault()
            ?? versions.Where(x => x.Status == RouteVersionStatus.Published).OrderByDescending(x => x.VersionNumber).FirstOrDefault();
        SelectedStageKey = Route?.Stages.OrderBy(x => x.Sequence).FirstOrDefault()?.StageKey;
    }

    private async Task CreateDraftAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.RouteVersions.AnyAsync(x => x.Route.DocumentTypeId == SelectedDocumentTypeId && x.Status == RouteVersionStatus.Draft))
        {
            Message = "An editable draft already exists for this document type.";
            IsError = true;
            await LoadRouteAsync();
            return;
        }
        var source = await VersionGraph(db).AsNoTrackingWithIdentityResolution()
            .Where(x => x.Route.DocumentTypeId == SelectedDocumentTypeId && x.Status == RouteVersionStatus.Published)
            .OrderByDescending(x => x.VersionNumber).FirstAsync();
        var draft = RouteCloner.CloneAsDraft(source);
        db.RouteVersions.Add(draft);
        db.AuditEvents.Add(new AuditEvent { ActorUserId = await CurrentUserIdAsync(), EventType = "RouteDraftCreated", Details = $"Created route draft version {draft.VersionNumber}." });
        await db.SaveChangesAsync();
        Message = "Draft created. Published behavior is unchanged until publication.";
        IsError = false;
        await LoadRouteAsync();
    }

    private async Task SaveDraftAsync()
    {
        if (await SaveDraftGraphAsync())
        {
            Message = Readiness.IsReady ? "Draft saved and ready for publication." : "Draft saved with validation issues to resolve.";
            IsError = false;
            await LoadRouteAsync();
        }
    }

    private async Task<bool> SaveDraftGraphAsync()
    {
        if (Route is null || !IsDraft) return false;
        await using var db = await DbFactory.CreateDbContextAsync();
        await using var transaction = await db.Database.BeginTransactionAsync();
        var target = await VersionGraph(db).SingleAsync(x => x.Id == Route.Id && x.Status == RouteVersionStatus.Draft);
        target.Name = Route.Name.Trim();
        var oldStages = target.Stages.ToList();
        var oldGroups = oldStages.SelectMany(x => x.ConditionGroups).ToList();
        db.RouteConditionOperands.RemoveRange(oldGroups.SelectMany(x => x.Rules).SelectMany(x => x.Operands));
        db.RouteConditionRules.RemoveRange(oldGroups.SelectMany(x => x.Rules));
        db.RouteConditionGroups.RemoveRange(oldGroups);
        db.AlertPolicies.RemoveRange(oldStages.SelectMany(x => x.AlertPolicies));
        db.RouteStages.RemoveRange(oldStages);
        await db.SaveChangesAsync();
        target.Stages.Clear();
        foreach (var stage in Route.Stages.OrderBy(x => x.Sequence)) target.Stages.Add(RouteCloner.CloneStage(stage, target));
        db.AuditEvents.Add(new AuditEvent { ActorUserId = await CurrentUserIdAsync(), EventType = "RouteDraftSaved", Details = $"Saved route draft version {target.VersionNumber}." });
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        return true;
    }

    private async Task BeginPublishAsync()
    {
        if (!await SaveDraftGraphAsync()) return;
        await LoadRouteAsync();
        var readiness = Readiness;
        if (!readiness.IsReady)
        {
            Message = $"{readiness.Errors.Count} publish-blocking issue{(readiness.Errors.Count == 1 ? "" : "s")} must be fixed.";
            IsError = true;
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var published = await VersionGraph(db).AsNoTrackingWithIdentityResolution()
            .Where(x => x.Route.DocumentTypeId == SelectedDocumentTypeId && x.Status == RouteVersionStatus.Published)
            .OrderByDescending(x => x.VersionNumber).FirstOrDefaultAsync();
        PublishDiff = RouteDiff.Compare(published, Route!, ConditionFields);
        ShowPublishReview = true;
        IsError = false;
        Message = null;
        await Task.Yield();
        await PublishPanel.FocusAsync();
    }

    private async Task ConfirmPublishAsync()
    {
        if (Route is null || !IsDraft || IsPublishing) return;
        IsPublishing = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();
            var draft = await VersionGraph(db).SingleAsync(x => x.Id == Route.Id && x.Status == RouteVersionStatus.Draft);
            var fields = await db.DocumentFields.AsNoTracking().Where(x => x.DocumentTypeId == SelectedDocumentTypeId).ToListAsync();
            var users = await db.Users.AsNoTracking().ToListAsync();
            var lifecycle = await db.LifecycleNotificationRules.AsNoTracking().Where(x => x.DocumentTypeId == SelectedDocumentTypeId).ToListAsync();
            var validation = RouteValidator.Validate(draft, fields, users, lifecycle);
            if (!validation.IsReady)
            {
                await transaction.RollbackAsync();
                Message = "Publication stopped because server-side validation found new errors.";
                IsError = true;
                ShowPublishReview = false;
                return;
            }
            var published = await VersionGraph(db).Where(x => x.RouteId == draft.RouteId && x.Status == RouteVersionStatus.Published).ToListAsync();
            var latest = published.OrderByDescending(x => x.VersionNumber).FirstOrDefault();
            var diff = RouteDiff.Compare(latest, draft, ConditionField.Build(fields));
            foreach (var version in published) version.Status = RouteVersionStatus.Retired;
            draft.Status = RouteVersionStatus.Published;
            draft.PublishedAtUtc = DateTimeOffset.UtcNow;
            draft.PublishedById = await CurrentUserIdAsync();
            db.AuditEvents.Add(new AuditEvent
            {
                ActorUserId = draft.PublishedById.Value,
                EventType = "RoutePublished",
                Details = $"Published route version {draft.VersionNumber}: {diff.Summary}."
            });
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            Message = $"Version {draft.VersionNumber} published for new requests. Existing requests remain on their original route versions.";
            IsError = false;
            ShowPublishReview = false;
            await LoadRouteAsync();
        }
        finally
        {
            IsPublishing = false;
        }
    }

    private void ClosePublishReview() => ShowPublishReview = false;
    private void CloseStageEditor() => SelectedStageKey = null;
    private void PublishPanelKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") ClosePublishReview();
    }
    private void StagePanelKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseStageEditor();
    }

    private void InsertStage(string? afterStageKey)
    {
        if (Route is null || !IsDraft) return;
        var stages = Route.Stages.OrderBy(x => x.Sequence).ToList();
        var index = afterStageKey is null ? stages.Count : stages.FindIndex(x => x.StageKey == afterStageKey) + 1;
        var namedApprover = Users.FirstOrDefault(x => x.IsActive && x.Roles.Contains(Roles.Approver, StringComparer.OrdinalIgnoreCase)) ?? Users.FirstOrDefault(x => x.IsActive);
        var stage = new ApprovalRouteStage
        {
            RouteVersion = Route,
            StageKey = Guid.NewGuid().ToString("N"),
            Name = "New approval stage",
            AssignmentStrategy = AssignmentStrategy.NamedUser,
            NamedApproverId = namedApprover?.Id,
            SignatureRequired = true,
            IsConditional = false
        };
        AddDefaultAlerts(stage);
        stages.Insert(Math.Max(0, index), stage);
        Route.Stages = stages;
        RenumberStages();
        SelectedStageKey = stage.StageKey;
    }

    private void RemoveStage(string stageKey)
    {
        if (Route is null || !IsDraft) return;
        var stage = Route.Stages.Single(x => x.StageKey == stageKey);
        Route.Stages.Remove(stage);
        RenumberStages();
        SelectedStageKey = Route.Stages.OrderBy(x => x.Sequence).FirstOrDefault()?.StageKey;
    }

    private void MoveStage(string stageKey, int direction)
    {
        if (Route is null || !IsDraft) return;
        var ordered = Route.Stages.OrderBy(x => x.Sequence).ToList();
        var index = ordered.FindIndex(x => x.StageKey == stageKey);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        Route.Stages = ordered;
        RenumberStages();
    }

    private void BeginDrag(string stageKey)
    {
        if (IsDraft) DraggedStageKey = stageKey;
    }

    private void DropBefore(string targetStageKey)
    {
        if (Route is null || !IsDraft || DraggedStageKey is null || DraggedStageKey == targetStageKey) return;
        var ordered = Route.Stages.OrderBy(x => x.Sequence).ToList();
        var moving = ordered.Single(x => x.StageKey == DraggedStageKey);
        ordered.Remove(moving);
        var targetIndex = ordered.FindIndex(x => x.StageKey == targetStageKey);
        ordered.Insert(Math.Max(0, targetIndex), moving);
        Route.Stages = ordered;
        DraggedStageKey = null;
        RenumberStages();
    }

    private void RenumberStages()
    {
        if (Route is null) return;
        var ordered = Route.Stages.OrderBy(x => x.Sequence).ToList();
        for (var index = 0; index < ordered.Count; index++) ordered[index].Sequence = index + 1;
        Route.Stages = ordered;
    }

    private async Task SelectStageAsync(string stageKey)
    {
        SelectedStageKey = stageKey;
        await Task.Yield();
        await StagePanel.FocusAsync();
    }

    private async Task FocusIssueAsync(RouteValidationIssue issue)
    {
        if (!string.IsNullOrWhiteSpace(issue.StageKey)) await SelectStageAsync(issue.StageKey);
    }

    private void SetConditional(ApprovalRouteStage stage, bool conditional)
    {
        if (!IsDraft) return;
        stage.IsConditional = conditional;
        if (conditional && RootGroup(stage) is null)
        {
            var root = new RouteConditionGroup { Stage = stage, StableGroupKey = Guid.NewGuid().ToString("N"), Combinator = ConditionCombinator.And, Sequence = 1 };
            stage.ConditionGroups.Add(root);
        }
    }

    private static RouteConditionGroup? RootGroup(ApprovalRouteStage stage) =>
        stage.ConditionGroups.SingleOrDefault(x => x.ParentGroupId is null && x.ParentGroup is null);

    private Task ConfigurationChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ResetSimulationValues()
    {
        SimulationValues = new(StringComparer.OrdinalIgnoreCase) { ["title"] = "", ["department"] = "" };
        foreach (var field in CurrentFields) SimulationValues[field.Key] = "";
    }

    private string SimulationValue(string key) => SimulationValues.TryGetValue(key, out var value) ? value ?? "" : "";
    private void SetSimulation(string key, string? value) => SimulationValues[key] = value;
    private ConditionEvaluationContext SimulationContext() => new()
    {
        Title = SimulationValue("title"),
        Department = SimulationValue("department"),
        RequesterManagerId = SimulationManagerId,
        Values = SimulationValues
    };

    private async Task<Guid> CurrentUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return Guid.Parse(state.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);
    }

    private static IQueryable<ApprovalRouteVersion> VersionGraph(AppDbContext db) => db.RouteVersions
        .Include(x => x.Route)
        .Include(x => x.Stages).ThenInclude(x => x.ConditionGroups).ThenInclude(x => x.Rules).ThenInclude(x => x.Operands)
        .Include(x => x.Stages).ThenInclude(x => x.AlertPolicies)
        .Include(x => x.Stages).ThenInclude(x => x.NamedApprover);

    private string AssignmentLabel(ApprovalRouteStage stage) => stage.AssignmentStrategy switch
    {
        AssignmentStrategy.RequesterManager => "Requester’s confirmed manager",
        AssignmentStrategy.NamedUser => Users.FirstOrDefault(x => x.Id == stage.NamedApproverId)?.FullName ?? "Named person not selected",
        AssignmentStrategy.UserField => $"Person from {CurrentFields.FirstOrDefault(x => x.Key == stage.AssigneeFieldKey)?.Label ?? "request field"}",
        _ => "Unknown assignment"
    };

    private static string StrategyLabel(AssignmentStrategy strategy) => strategy switch
    {
        AssignmentStrategy.RequesterManager => "Requester Manager",
        AssignmentStrategy.NamedUser => "Named Person",
        AssignmentStrategy.UserField => "Person From Request Field",
        _ => strategy.ToString()
    };

    private static string AlertSummary(ApprovalRouteStage stage)
    {
        var reminder = stage.AlertPolicies.FirstOrDefault(x => x.EventType == AlertEventType.Reminder);
        var escalation = stage.AlertPolicies.FirstOrDefault(x => x.EventType == AlertEventType.Escalation);
        return $"Alerts · reminder {(reminder?.IsEnabled == true ? $"{reminder.DelayHours}h" : "off")} · escalation {(escalation?.IsEnabled == true ? $"{escalation.DelayHours}h" : "off")}";
    }

    private static void AddDefaultAlerts(ApprovalRouteStage stage)
    {
        stage.AlertPolicies.Add(Alert(stage, AlertEventType.Assignment, AlertRecipientStrategy.StageApprover, 0, true, true, true));
        stage.AlertPolicies.Add(Alert(stage, AlertEventType.Reminder, AlertRecipientStrategy.StageApprover, 48, true, true, true));
        stage.AlertPolicies.Add(Alert(stage, AlertEventType.Escalation, AlertRecipientStrategy.ApproverManagerOrAdministrator, 120, true, true, true));
        stage.AlertPolicies.Add(Alert(stage, AlertEventType.Outcome, AlertRecipientStrategy.Requester, 0, true, true, false));
    }

    private static AlertPolicy Alert(ApprovalRouteStage stage, AlertEventType eventType, AlertRecipientStrategy recipient,
        int delay, bool inApp, bool email, bool teams) => new()
    {
        Stage = stage, EventType = eventType, RecipientStrategy = recipient, DelayHours = delay,
        InAppEnabled = inApp, EmailEnabled = email, TeamsEnabled = teams, MaxDeliveryAttempts = 3, IsEnabled = true
    };

    private sealed record DocumentTypeSummary(Guid Id, string Name);
}
