@inherits LayoutComponentBase
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-shell">
    <aside class="app-sidebar" id="app-sidebar" aria-label="Application navigation" tabindex="-1">
        <div class="sidebar-brand-row">
            <a class="sidebar-brand" href="/" aria-label="Document Routing home">
                <span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /><path d="M10 6.5h3a4 4 0 0 1 4 4V14M7 10v7h7" /></svg></span>
                <span class="brand-copy"><strong>Document</strong><span>Routing</span></span>
            </a>
            <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" title="Collapse navigation">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5" /></svg>
                <span class="visually-hidden">Collapse navigation</span>
            </button>
        </div>

        <nav class="sidebar-nav" aria-label="Primary navigation">
            <NavLink class="nav-link" ActiveClass="is-active" href="/" Match="@NavLinkMatch.All" title="Dashboard">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                <span class="nav-label">Dashboard</span>
            </NavLink>

            <div class="nav-group">
                <span class="nav-group-label">Work</span>
                <NavLink class="nav-link" ActiveClass="is-active" href="/approvals" title="My approvals">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                    <span class="nav-label">My approvals</span>
                    @if (PendingApprovals > 0)
                    {
                        <span class="nav-badge">@PendingApprovals</span>
                    }
                </NavLink>
                <NavLink class="nav-link" ActiveClass="is-active" href="/requests" title="My requests">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" /></svg>
                    <span class="nav-label">My requests</span>
                </NavLink>
                @if (IsAdministrator)
                {
                    <NavLink class="nav-link" ActiveClass="is-active" href="/admin/requests" title="All requests">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 4h3a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2v-2" /><path d="M3 4h11v12H3zM6 8h5M6 12h4" /></svg>
                        <span class="nav-label">All requests</span>
                    </NavLink>
                }
                <NavLink class="nav-link" ActiveClass="is-active" href="/notifications" title="Alerts">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                    <span class="nav-label">Alerts</span>
                    @if (UnreadAlerts > 0)
                    {
                        <span class="nav-badge subtle">@UnreadAlerts</span>
                    }
                </NavLink>
            </div>

            @if (IsAdministrator)
            {
                <div class="nav-group">
                    <span class="nav-group-label">Configuration</span>
                    <NavLink class="nav-link" ActiveClass="is-active" href="/route-designer" title="Workflows">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="2" /><circle cx="18" cy="18" r="2" /><path d="M8 6h3a4 4 0 0 1 4 4v4M6 8v6a4 4 0 0 0 4 4h6" /></svg>
                        <span class="nav-label">Workflows</span>
                    </NavLink>
                    <NavLink class="nav-link" ActiveClass="is-active" href="/admin/document-types" title="Document types">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" /></svg>
                        <span class="nav-label">Document types</span>
                    </NavLink>
                </div>
                <div class="nav-group">
                    <span class="nav-group-label">Administration</span>
                    <NavLink class="nav-link" ActiveClass="is-active" href="/admin/routes" title="Administration">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" /><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V21h-4v-.09A1.7 1.7 0 0 0 9 19.36a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.63 15 1.7 1.7 0 0 0 3.08 14H3v-4h.09A1.7 1.7 0 0 0 4.64 9a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.63 1.7 1.7 0 0 0 10 3.08V3h4v.09A1.7 1.7 0 0 0 15 4.64a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.37 9 1.7 1.7 0 0 0 20.92 10H21v4h-.09A1.7 1.7 0 0 0 19.4 15z" /></svg>
                        <span class="nav-label">Administration</span>
                    </NavLink>
                </div>
            }
        </nav>

        <div class="sidebar-footer">
            <NavLink class="nav-link utility-link" ActiveClass="is-active" href="/help" title="Help">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 1 1 3.3 2.37c-.8.3-.8.88-.8 1.63M12 17h.01" /></svg>
                <span class="nav-label">Help</span>
            </NavLink>
            <details class="account-menu">
                <summary>
                    <span class="user-avatar">@Initials</span>
                    <span class="account-copy"><strong>@UserName</strong><small>@Email</small></span>
                    <svg class="account-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg>
                </summary>
                <div class="account-popover">
                    <strong>@UserName</strong><small>@Email</small>
                    <a class="account-action" href="/account/login">Switch demo user</a>
                </div>
            </details>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <button class="mobile-menu-button" type="button" data-sidebar-open aria-controls="app-sidebar" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                <span class="visually-hidden">Open navigation</span>
            </button>
            <div class="topbar-context"><span>Configuration</span><strong>Workflow designer</strong></div>
            <div class="topbar-actions">
                <a class="notification-button" href="/notifications" aria-label="Notifications, @UnreadAlerts unread">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                    @if (UnreadAlerts > 0)
                    {
                        <span>@(UnreadAlerts > 99 ? "99+" : UnreadAlerts.ToString())</span>
                    }
                </a>
            </div>
        </header>
        <main class="page-shell designer-shell">@Body</main>
        <footer class="app-footer">Demonstration environment · .NET 10 Blazor configuration workspace · SQLite</footer>
    </div>
    <button class="sidebar-backdrop" type="button" data-sidebar-close aria-label="Close navigation"></button>
</div>
<div id="blazor-error-ui">An unexpected error occurred. <a href="." class="reload">Reload</a></div>

@code {
    private string UserName { get; set; } = "Current user";
    private string Email { get; set; } = "";
    private string Initials { get; set; } = "U";
    private int UnreadAlerts { get; set; }
    private int PendingApprovals { get; set; }
    private bool IsAdministrator { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authenticationState.User;
        UserName = principal.Identity?.Name ?? "Current user";
        Email = principal.FindFirst(ClaimTypes.Email)?.Value ?? "";
        IsAdministrator = principal.IsInRole(Roles.SystemAdmin);
        Initials = string.Concat(UserName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => char.ToUpperInvariant(x[0])));
        if (string.IsNullOrWhiteSpace(Initials)) Initials = "U";

        if (!Guid.TryParse(principal.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var userId)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        UnreadAlerts = await db.NotificationOutbox.AsNoTracking()
            .CountAsync(x => x.UserId == userId && !x.IsRead && x.Status != NotificationStatus.Cancelled);
        PendingApprovals = await db.ApprovalInstances.AsNoTracking()
            .CountAsync(x => x.ApproverId == userId && x.Status == ApprovalStatus.Pending);
    }
}
